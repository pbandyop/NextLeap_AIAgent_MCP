# Copy to .env and fill in your values:
#   copy .env.example .env
#
# Get a Groq API key: https://console.groq.com/keys

# Required for Phase 2 analysis with real LLM (omit to use --stub-llm on dry-run)
GROQ_API_KEY=

# Optional — defaults shown
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Rate limits (see docs/architecture.md §6.1.1)
# GROQ_MAX_REQUESTS_PER_RUN=10
# GROQ_MAX_CLUSTERS_POSITIVE=5
# GROQ_MAX_CLUSTERS_CRITICAL=3
# GROQ_MAX_TOKENS_PER_REQUEST=1200
# GROQ_MAX_TOKENS_PER_RUN=9000
# GROQ_INTER_REQUEST_DELAY_MS=2500
# GROQ_DAILY_TOKEN_BUDGET=80000

# Agent runtime
PULSE_ENV=dev
EMAIL_MODE=draft

# Phase 5 — Gmail delivery (workspace HTTP MCP server creates drafts)
# Recipient for weekly pulse emails (required for Phase 5)
PULSE_EMAIL_TO=you@example.com
# PULSE_EMAIL_TO_GROWW=stakeholder@company.com

# Phase 7 — environment profile (dev | staging | production)
# PULSE_ENV=dev
# Production send gate (only when EMAIL_MODE=send and PULSE_ENV=production)
# PULSE_PRODUCTION_SEND_APPROVED=false

# Phase 4 — Google Docs delivery (workspace HTTP MCP server)
# GOOGLE_MCP_BASE_URL=https://saksham-mcp-server-production-b243.up.railway.app
# Per-product Doc ID (from Google Doc URL: .../d/DOC_ID/edit)
PULSE_DOC_ID_GROWW=
# PULSE_DOC_ID_INDMONEY=
# PULSE_DOC_ID_POWERUP=
# PULSE_DOC_ID_WEALTH_MONITOR=
# PULSE_DOC_ID_KUVERA=
